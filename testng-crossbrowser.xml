<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHealth Cross Browser Suite" verbose="1" parallel="tests" thread-count="2" data-provider-thread-count="2">

    <parameter name="crossBrowser" value="true"/>

    <listeners>
        <listener class-name="com.orangehealth.reports.ExtentTestListener"/>
    </listeners>

    <!-- Browser 1 - All Modules -->
    <test name="Browser 1 - All Modules">
        <parameter name="browser" value="${browser1}"/>
        <classes>
            <class name="com.orangehealth.runners.CrossBrowserTestRunner"/>
        </classes>
    </test>

    <!-- Browser 2 - All Modules -->
    <test name="Browser 2 - All Modules">
        <parameter name="browser" value="${browser2}"/>
        <classes>
            <class name="com.orangehealth.runners.CrossBrowserTestRunner"/>
        </classes>
    </test>

</suite>

