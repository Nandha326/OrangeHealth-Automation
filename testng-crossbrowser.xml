<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHealth Cross Browser Suite" verbose="1" parallel="none">

    <parameter name="crossBrowser" value="true"/>

    <listeners>
        <listener class-name="com.orangehealth.reports.ExtentTestListener"/>
    </listeners>

    <!-- Chrome Browser - All Modules -->
    <test name="Chrome - All Modules">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.orangehealth.runners.CrossBrowserTestRunner"/>
        </classes>
    </test>

    <!-- Edge Browser - All Modules -->
    <test name="Edge - All Modules">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.orangehealth.runners.CrossBrowserTestRunner"/>
        </classes>
    </test>

    <!-- Firefox Browser - All Modules -->
    <test name="Firefox - All Modules">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.orangehealth.runners.CrossBrowserTestRunner"/>
        </classes>
    </test>

</suite>
